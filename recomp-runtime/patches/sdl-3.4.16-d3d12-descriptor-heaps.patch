+/* Makes room for the descriptors a bind is about to write. Acquiring new heaps when either is too full
+ * invalidates every descriptor table set so far (SetDescriptorHeaps), so when this returns true the caller
+ * must rewrite all of its tables, not only the dirty ones. A partial write past the end of a heap would
+ * corrupt memory, and a table left pointing into the old heap makes the GPU read the wrong descriptors. */
+static bool D3D12_INTERNAL_ReserveGPUDescriptors(
+    D3D12CommandBuffer *commandBuffer,
+    Uint32 viewCount,
+    Uint32 samplerCount)
+{
+    D3D12DescriptorHeap *viewHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV];
+    D3D12DescriptorHeap *samplerHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER];
+
+    if (viewHeap->currentDescriptorIndex + viewCount <= viewHeap->maxDescriptors &&
+        samplerHeap->currentDescriptorIndex + samplerCount <= samplerHeap->maxDescriptors) {
+        return false;
+    }
+
+    D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
+    return true;
+}
